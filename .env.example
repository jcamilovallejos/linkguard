POSTGRES_USER=linkguard
POSTGRES_PASSWORD=linkguard
POSTGRES_DB=linkguard
POSTGRES_PORT=5432

REDIS_PORT=6379

HTTP_PORT=8080
BASE_URL=http://localhost:8080

# Sliding Window Counter: requests allowed per window, per company
# (identified by the X-API-Key header), applied independently to each
# endpoint. Deliberately conservative — this runs on a local machine, not
# production infrastructure.
RATE_LIMIT=100
RATE_WINDOW_SECONDS=1
